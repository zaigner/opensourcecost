# Copy to .env (git-ignored) and fill in. Real environment variables override .env.

# Recommended: unauthenticated GitHub allows only 60 requests/hour.
GITHUB_TOKEN=

# Optional overrides for model assumptions (defaults shown).
# OSSCOST_MEDIAN_WAGE=133080                  # BLS OOH median software developer wage (May 2024)
# OSSCOST_WAGE_SHARE_OF_COMP=0.701            # BLS ECEC Dec 2025
# OSSCOST_EFFORT_MULTIPLIER=1.287             # COCOMO II EAF: RELY high x CPLX high
# OSSCOST_COMMERCIAL_SHARE=0.8                # alpha
# OSSCOST_PYTHON_DEVELOPERS=23000000          # SlashData Q1 2025
# OSSCOST_ENTERPRISE_POOL=2000                # Forbes Global 2000
# OSSCOST_REMEDIATION_HOURS_PER_DEPENDENT=1.0
# OSSCOST_TEST_DIR_NAMES=["test","tests","testing","dummyserver"]
# OSSCOST_EXCLUDE_DIR_NAMES=["docs","doc","examples","example","benchmarks","bench","ci",".github","scripts","tools",".git"]
# OSSCOST_OUT_DIR=results
